# Docker Composeがホスト側に公開するポート。
# 既存の別プロセス/別プロジェクトのコンテナと衝突する場合はここを変更する。
# コンテナ間通信(frontend→backend→db)はDocker内部のポート固定なので影響を受けない。
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
CHAIN_RPC_PORT=8545

# PSA Public API MVP。実際の値はローカルの.envだけに置く。
PSA_MVP_ENABLED=false
PSA_API_TOKEN=

# 非同期オンチェーン記録MVP。`blockchain` profileを使う場合だけtrueにする。
ONCHAIN_MVP_ENABLED=false
ONCHAIN_ANCHOR_CONTRACT=0x5fbdb2315678afecb367f032d93f642f64180aa3
# Hardhat local nodeが公開する開発専用key。本番環境ではSecret Managerで管理する。
ONCHAIN_OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ONCHAIN_INTERNAL_TOKEN=local-onchain-internal-token-change-me

# SIWE + JPYC決済MVP。local chainのMockJPYC address。
PAYMENT_MVP_ENABLED=false
PAYMENT_JPYC_TOKEN_ADDRESS=0xe7f1725e7734ce288f8367e1bb143e90bb3f0512
PAYMENT_SESSION_SECRET=local-payment-session-secret-change-me
# MetaMask Embedded Wallets Dashboardで発行する。未設定時は決済demoを初期化しない。
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# Vision APIによるカード画像コンテンツチェックMVP。実際の値はローカルの.envだけに置く。
VISION_MVP_ENABLED=false
VISION_STORAGE_BUCKET=
VISION_ADMIN_TOKEN=local-vision-admin-token-change-me
# `gcloud auth application-default login --impersonate-service-account=<SAのメールアドレス>`で
# 発行されたADCファイルのホスト側絶対パス(既定: ~/.config/gcloud/application_default_credentials.json)。
GOOGLE_APPLICATION_CREDENTIALS_HOST=
