<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="購入フロー">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="商品を購入 → JPYCで送金&#xa;（購入者→販売者ウォレット直接）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="backend workerが着金確認&amp;決済確定&#xa;（receipt・Transferイベント照合）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="380" y="145" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="取引記録をハッシュ化し&#xa;ブロックチェーンへ非同期記録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="販売者が発送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="740" y="145" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="出品時にVision経路&#xa;（PSAなし）だったか?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="980" y="115" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="購入者が到着後に同一箇所を再撮影&#xa;→ Vision APIで比較・一致度を記録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1220" y="10" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="nfinal" value="取引完了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1600" y="145" width="200" height="80" as="geometry" />
