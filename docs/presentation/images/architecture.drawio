<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="システム構成">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Browser -->
        <mxCell id="browser" value="ブラウザ&#xa;(販売者 / 購入者)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- GCP container -->
        <mxCell id="gcp" value="GCP" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#666666;fontSize=14;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="480" height="410" as="geometry" />
        </mxCell>

        <mxCell id="fe" value="Next.js&#xa;(frontend / Cloud Run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="gcp">
          <mxGeometry x="140" y="50" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="be" value="Hono API&#xa;(backend / Cloud Run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="gcp">
          <mxGeometry x="140" y="170" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="db" value="PostgreSQL&#xa;(Cloud SQL)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;boundedLbl=1;" vertex="1" parent="gcp">
          <mxGeometry x="50" y="300" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="gcs" value="Cloud Storage&#xa;(カード画像)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0b8299;fontSize=13;boundedLbl=1;" vertex="1" parent="gcp">
          <mxGeometry x="250" y="300" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- External services -->
