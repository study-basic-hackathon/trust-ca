{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker:onchain": "tsx src/workers/onchain-anchor.ts",
    "worker:payment": "tsx src/workers/payment-verification.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-migrations.mjs",
    "test:onchain:db": "tsx scripts/test-onchain-outbox.ts",
    "test:onchain:e2e": "node scripts/test-onchain-e2e.mjs",
    "test:payment:e2e": "node scripts/test-payment-e2e.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7",
    "@hono/node-server": "^2.1.0",
    "google-auth-library": "^9",
    "hono": "^4",
    "jose": "^6.2.8",
    "pg": "^8",
    "viem": "^2.55.13"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.10"
  }
}
