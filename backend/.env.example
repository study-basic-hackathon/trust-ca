# サーバーのリッスンポート
PORT=8080

# PostgreSQL接続文字列
# Docker Compose外でbackendを単体起動する場合はこの値のまま使う。
# docker-compose経由で起動する場合は、Compose側でホストが `db` に上書きされる。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustca

# Trustca専用databaseではpublicを使用する。
# 他システムとdatabase自体を共有せざるを得ない場合はtrustca等の専用schemaへ変更する。
DATABASE_SCHEMA=public

# CORSで許可するフロントエンドのオリジン
FRONTEND_ORIGIN=http://localhost:3000

# 非同期オンチェーン記録MVP。通常のbackend開発時は無効のままにする。
ONCHAIN_MVP_ENABLED=false
ONCHAIN_RPC_URL=http://localhost:8545
ONCHAIN_CHAIN_ID=31337
ONCHAIN_CHAIN_NAME=Trustca Local
ONCHAIN_ANCHOR_CONTRACT=
ONCHAIN_OPERATOR_PRIVATE_KEY=
ONCHAIN_CONFIRMATIONS=1
ONCHAIN_RECEIPT_TIMEOUT_MS=60000
ONCHAIN_POLL_INTERVAL_MS=3000
ONCHAIN_BATCH_SIZE=5
ONCHAIN_LOCK_TIMEOUT_SECONDS=120
ONCHAIN_MAX_ATTEMPTS=8
# 内部API用。MVPを有効にする場合は32文字以上のrandom値へ置き換える。
ONCHAIN_INTERNAL_TOKEN=
