# サーバーのリッスンポート
PORT=8080

# PostgreSQL接続文字列
# Docker Compose外でbackendを単体起動する場合はこの値のまま使う。
# docker-compose経由で起動する場合は、Compose側でホストが `db` に上書きされる。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustca

# Trustca専用databaseではpublicを使用する。
# 他システムとdatabase自体を共有せざるを得ない場合はtrustca等の専用schemaへ変更する。
DATABASE_SCHEMA=public

# CORSで許可するフロントエンドのオリジン
FRONTEND_ORIGIN=http://localhost:3000

# PSA Public API MVP。資格情報を設定したうえで明示的に有効化する。
# トークンはリポジトリへコミットせず、本番ではSecret Managerから注入する。
PSA_MVP_ENABLED=false
PSA_API_TOKEN=
PSA_API_BASE_URL=https://api.psacard.com/publicapi
PSA_API_TIMEOUT_MS=5000
PSA_CACHE_TTL_SECONDS=86400
PSA_REQUESTS_PER_MINUTE=10

# 非同期オンチェーン記録MVP。通常のbackend開発時は無効のままにする。
ONCHAIN_MVP_ENABLED=false
ONCHAIN_RPC_URL=http://localhost:8545
ONCHAIN_CHAIN_ID=31337
ONCHAIN_CHAIN_NAME=Trustca Local
ONCHAIN_ANCHOR_CONTRACT=
ONCHAIN_OPERATOR_PRIVATE_KEY=
ONCHAIN_CONFIRMATIONS=1
ONCHAIN_RECEIPT_TIMEOUT_MS=60000
ONCHAIN_POLL_INTERVAL_MS=3000
ONCHAIN_BATCH_SIZE=5
ONCHAIN_LOCK_TIMEOUT_SECONDS=120
ONCHAIN_MAX_ATTEMPTS=8
# 内部API用。MVPを有効にする場合は32文字以上のrandom値へ置き換える。
ONCHAIN_INTERNAL_TOKEN=

# Web3Auth（MetaMask Embedded Wallets）+ SIWE + JPYC決済MVP。
# 本番Polygonのcontract addressは公式情報と実chain上のmetadataを再確認して設定する。
PAYMENT_MVP_ENABLED=false
PAYMENT_RPC_URL=http://localhost:8545
PAYMENT_CHAIN_ID=31337
PAYMENT_CHAIN_NAME=Trustca Local
PAYMENT_JPYC_TOKEN_ADDRESS=
PAYMENT_EXPECTED_SYMBOL=JPYC
PAYMENT_CONFIRMATIONS=1
PAYMENT_POLL_INTERVAL_MS=3000
PAYMENT_BATCH_SIZE=5
PAYMENT_LOCK_TIMEOUT_SECONDS=120
PAYMENT_VERIFICATION_TIMEOUT_SECONDS=3600
PAYMENT_INTENT_LIFETIME_SECONDS=900
# HS256署名用。MVPを有効にする場合は32文字以上のrandom値へ置き換える。
PAYMENT_SESSION_SECRET=
PAYMENT_SESSION_TTL_SECONDS=3600
# EIP-4361 messageのdomainとURI。domainにはportを含めてもよい。
PAYMENT_SIWE_DOMAIN=localhost:3000
PAYMENT_SIWE_URI=http://localhost:3000
PAYMENT_CHALLENGE_TTL_SECONDS=300

# Vision APIによるカード画像コンテンツチェックMVP(PSAなし経路)。
# サービスアカウントの鍵ファイルは組織ポリシーで作成できないため、
# `gcloud auth application-default login --impersonate-service-account=<SAのメールアドレス>`
# でなりすまし用ADCを発行して使う(Cloud Runでは付与済みサービスアカウントを使うため不要)。
# GOOGLE_APPLICATION_CREDENTIALSはbackendを単体起動(`pnpm dev`)する場合のみ、
# 発行されたADCファイルの絶対パス(既定では~/.config/gcloud/application_default_credentials.json)を指定する。
# Docker Compose経由の場合はリポジトリルートの.envでGOOGLE_APPLICATION_CREDENTIALS_HOSTを設定する
# (docker-compose.yml側でコンテナ内の固定パスへマウントするため、この変数自体はCompose環境では上書きされる)。
VISION_MVP_ENABLED=false
VISION_STORAGE_BUCKET=
VISION_API_BASE_URL=https://vision.googleapis.com/v1
VISION_API_TIMEOUT_MS=10000
VISION_UPLOAD_URL_TTL_SECONDS=900
# 運営者向け要確認一覧APIの内部トークン。有効にする場合は32文字以上のrandom値へ置き換える。
VISION_ADMIN_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
