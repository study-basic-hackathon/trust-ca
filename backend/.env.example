# サーバーのリッスンポート
PORT=8080

# PostgreSQL接続文字列
# Docker Compose外でbackendを単体起動する場合はこの値のまま使う。
# docker-compose経由で起動する場合は、Compose側でホストが `db` に上書きされる。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustca

# CORSで許可するフロントエンドのオリジン
FRONTEND_ORIGIN=http://localhost:3000

# PSA Public API MVP。資格情報を設定したうえで明示的に有効化する。
# トークンはリポジトリへコミットせず、本番ではSecret Managerから注入する。
PSA_MVP_ENABLED=false
PSA_API_TOKEN=
PSA_API_BASE_URL=https://api.psacard.com/publicapi
PSA_API_TIMEOUT_MS=5000
PSA_CACHE_TTL_SECONDS=86400
PSA_REQUESTS_PER_MINUTE=10
