# Didit (https://business.didit.me/ → Application → API Key)
DIDIT_API_KEY=
# Didit console で作成したワークフローのID (ID Verification + Liveness + Face Match 推奨)
DIDIT_WORKFLOW_ID=
# Webhook設定時に発行される共有シークレット (ローカルのポーリング検証だけなら未設定でも動く)
DIDIT_WEBHOOK_SECRET_KEY=
# 通常は変更不要
DIDIT_BASE_URL=https://verification.didit.me
APP_BASE_URL=http://localhost:3000
